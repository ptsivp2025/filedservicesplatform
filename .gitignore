# Dependencies — JANGAN commit, akan di-install via npm install
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Production
*.tsbuildinfo
next-env.d.ts

# Environment variables — RAHASIA, jangan commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Vercel
.vercel

# Claude Code
# Setelan LOKAL (settings.local.json, dsb) tetap diabaikan — itu preferensi
# per-mesin. Tapi .claude/skills/ SENGAJA dilacak: skill adalah kemampuan
# bersama tim, dan sesi Claude Code berjalan di container sementara, jadi
# tanpa ikut ter-commit skill-nya hilang tiap kali sesi baru dimulai.
# ".claude/*" (bukan ".claude/") supaya git tetap bisa masuk ke dalamnya
# dan aturan pengecualian di bawah berlaku.
.claude/*
!.claude/skills/
.git-commit-msg.tmp

.vercel

# Artefak kompilasi Python (mis. dari skrip skill)
__pycache__/
*.pyc

# Android (Capacitor) — local.properties berisi path SDK MESIN KAMU sendiri,
# bukan punya orang lain. Keystore signing JANGAN PERNAH commit — itu kunci
# yang membuktikan APK-mu ke Android, kalau bocor siapa pun bisa
# menandatangani APK palsu mengaku dari app ini. CI membacanya dari GitHub
# Secrets (ANDROID_KEYSTORE_BASE64), bukan dari file di repo.
android/local.properties
android/**/.gradle/
*.keystore
*.jks
